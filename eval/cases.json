    "expected_ids": ["invoice"],
    "note": "Company mentioned only in body."
  },
  {
    "message": "search for a file mentioning forecast",
    "rounds": [
      [
        {
          "name": "drive_search",
          "args": {
            "query": "fullText contains 'forecast'"
          }
        }
      ]
