  },
  {
    "message": "find pdfs modified after january 1, 2025",
    "rounds": [
      [
        {
          "name": "drive_search",
          "args": {
            "query": "mimeType = 'application/pdf' and modifiedTime > '2025-01-01T00:00:00Z'"
          }
        }
      ]
    ],
    "expected_ids": ["invoice"],
    "note": "Date and type intersection."
  },
  {
    "message": "find pdfs modified before january 1, 2025",
    "rounds": [
      [
        {
          "name": "drive_search",
          "args": {
            "query": "mimeType = 'application/pdf' and modifiedTime < '2025-01-01T00:00:00Z'"
          }
        }
      ]
    ],
    "expected_ids": ["report"],
    "note": "Upper date bound."
