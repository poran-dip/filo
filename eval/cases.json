[
  {
    "message": "find every pdf",
    "rounds": [
      [
        {
          "name": "drive_search",
          "args": {
            "query": "mimeType = 'application/pdf'"
          }
        }
      ]
    ],
    "expected_ids": ["invoice", "report"],
    "note": "Includes nested files and excludes deleted and out-of-scope copies."
  },
  {
